<Window x:Class="Nexus_Recoil.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="440"
        Height="460"
        WindowStartupLocation="CenterScreen"
        Title="Changelog">

    <Border Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource SepBrush}"
            BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Rectangle Grid.Row="0" Fill="{DynamicResource SurfaceBrush}"/>
            <Grid Grid.Row="0" Margin="12,0"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown"
                  Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⊕" Foreground="{DynamicResource AccentBrush}"
                               FontSize="15" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="TitleText" Text="What's New"
                               Foreground="{DynamicResource TextPrimBrush}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource CloseButtonStyle}"
                        Content="✕" HorizontalAlignment="Right"
                        Click="CloseBtn_Click"/>
            </Grid>

            <!-- Scrollable body -->
            <ScrollViewer Grid.Row="1" Margin="14,12,14,8"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="BodyText"
                           Foreground="{DynamicResource TextPrimBrush}"
                           FontSize="12" FontFamily="Segoe UI"
                           TextWrapping="Wrap" LineHeight="20"/>
            </ScrollViewer>

            <!-- Footer buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="14,0,14,14">
                <Button Content="Download Update"
                        Style="{StaticResource NxButton}"
                        Margin="0,0,8,0"
                        Click="DownloadBtn_Click"/>
                <Button Content="Dismiss"
                        Style="{StaticResource NxButton}"
                        Click="DismissBtn_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
