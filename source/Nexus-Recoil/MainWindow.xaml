<Window x:Class="Nexus_Recoil.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Visibility="Hidden"
        Opacity="0"
        Width="390"
        Height="680"
        Title="Nexus Recoil"
        FontFamily="Segoe UI">

    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource SepBrush}"
            BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Header ───────────────────────────────────────────── -->
            <Rectangle Grid.Row="0" Fill="{DynamicResource SurfaceBrush}"/>
            <Grid Grid.Row="0" Margin="12,0"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⊕" Foreground="{DynamicResource AccentBrush}" FontSize="15"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="Nexus Recoil" Foreground="{DynamicResource TextPrimBrush}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource ElevatedBrush}" CornerRadius="3"
                            Margin="8,0,0,0" Padding="5,2">
                        <TextBlock Text="v1.0.5" Foreground="{DynamicResource TextSecBrush}"
                                   FontSize="10" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#e03030"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#e03030"/>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock x:Name="StatusText" Text="INACTIVE" Foreground="#e03030"
                               FontSize="10" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="6,0,12,0"/>
                    <Button Style="{StaticResource CloseButtonStyle}"
                            Content="✕" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- ── Content ──────────────────────────────────────────── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14,10,14,0">

                    <!-- ══ OUTER TAB CONTROL ════════════════════════════ -->
                    <TabControl x:Name="MainTabs" Style="{StaticResource NxTabControl}"
                                Margin="0,0,0,14">

                        <!-- ─── TAB 1: Recoil ─────────────────────────── -->
                        <TabItem Header="Recoil" Style="{StaticResource NxTabItem}">
                            <StackPanel Margin="0,10,0,10">

                                <!-- Section header -->
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="RECOIL COMPENSATION"
                                               Foreground="{DynamicResource TextSecBrush}"
                                               FontSize="10" FontWeight="SemiBold"
                                               DockPanel.Dock="Left" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Separator Background="{DynamicResource SepBrush}"
                                               Height="1" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- 2×2 slider grid -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <!-- Down -->
                                    <Border Grid.Column="0" Grid.Row="0"
                                            Background="{DynamicResource SurfaceBrush}"
                                            CornerRadius="5" Padding="10,8"
                                            ToolTip="Pulls mouse down while shooting. Raise if bullets go too high.">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBox x:Name="DownBox" Text="12.00"
                                                         Style="{StaticResource NxTextBox}"
                                                         DockPanel.Dock="Right"
                                                         GotFocus="RecoilBox_GotFocus"
                                                         LostFocus="DownBox_LostFocus"/>
                                                <TextBlock Text="↓" Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Down" Foreground="{DynamicResource TextSecBrush}"
                                                           FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                            </DockPanel>
                                            <Slider x:Name="DownSlider" Style="{StaticResource NxSlider}"
                                                    Minimum="0" Maximum="50" Value="12"
                                                    TickFrequency="0.1" SmallChange="0.1" LargeChange="1"
                                                    Margin="0,6,0,0"
                                                    ValueChanged="DownSlider_ValueChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Up -->
                                    <Border Grid.Column="2" Grid.Row="0"
                                            Background="{DynamicResource SurfaceBrush}"
                                            CornerRadius="5" Padding="10,8"
                                            ToolTip="Pulls mouse up while shooting. Usually kept at 0.">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBox x:Name="UpBox" Text="0.00"
                                                         Style="{StaticResource NxTextBox}"
                                                         DockPanel.Dock="Right"
                                                         GotFocus="RecoilBox_GotFocus"
                                                         LostFocus="UpBox_LostFocus"/>
                                                <TextBlock Text="↑" Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Up" Foreground="{DynamicResource TextSecBrush}"
                                                           FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                            </DockPanel>
                                            <Slider x:Name="UpSlider" Style="{StaticResource NxSlider}"
                                                    Minimum="0" Maximum="50" Value="0"
                                                    TickFrequency="0.1" SmallChange="0.1" LargeChange="1"
                                                    Margin="0,6,0,0"
                                                    ValueChanged="UpSlider_ValueChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Right -->
                                    <Border Grid.Column="0" Grid.Row="2"
                                            Background="{DynamicResource SurfaceBrush}"
                                            CornerRadius="5" Padding="10,8"
                                            ToolTip="Pulls mouse right. Adjust if bullets drift left.">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBox x:Name="RightBox" Text="4.00"
                                                         Style="{StaticResource NxTextBox}"
                                                         DockPanel.Dock="Right"
                                                         GotFocus="RecoilBox_GotFocus"
                                                         LostFocus="RightBox_LostFocus"/>
                                                <TextBlock Text="→" Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Right" Foreground="{DynamicResource TextSecBrush}"
                                                           FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                            </DockPanel>
                                            <Slider x:Name="RightSlider" Style="{StaticResource NxSlider}"
                                                    Minimum="0" Maximum="50" Value="4"
                                                    TickFrequency="0.1" SmallChange="0.1" LargeChange="1"
                                                    Margin="0,6,0,0"
                                                    ValueChanged="RightSlider_ValueChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Left -->
                                    <Border Grid.Column="2" Grid.Row="2"
                                            Background="{DynamicResource SurfaceBrush}"
                                            CornerRadius="5" Padding="10,8"
                                            ToolTip="Pulls mouse left. Adjust if bullets drift right.">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBox x:Name="LeftBox" Text="0.00"
                                                         Style="{StaticResource NxTextBox}"
                                                         DockPanel.Dock="Right"
                                                         GotFocus="RecoilBox_GotFocus"
                                                         LostFocus="LeftBox_LostFocus"/>
                                                <TextBlock Text="←" Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="Left" Foreground="{DynamicResource TextSecBrush}"
                                                           FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                            </DockPanel>
                                            <Slider x:Name="LeftSlider" Style="{StaticResource NxSlider}"
                                                    Minimum="0" Maximum="50" Value="0"
                                                    TickFrequency="0.1" SmallChange="0.1" LargeChange="1"
                                                    Margin="0,6,0,0"
                                                    ValueChanged="LeftSlider_ValueChanged"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Humanization -->
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="5" Padding="12,10" Margin="0,8,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Humanization"
                                                       Foreground="{DynamicResource TextPrimBrush}"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="HumanizationToggle" Grid.Column="1"
                                                          Style="{StaticResource NxToggle}"
                                                          ToolTip="Adds tiny random variation so recoil looks human."
                                                          Click="HumanizationToggle_Click"/>
                                        </Grid>
                                        <StackPanel x:Name="HumanizationPanel" Visibility="Collapsed"
                                                    Margin="0,10,0,0">
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock x:Name="HumanStrengthLabel" Text="Strength: 30%"
                                                           Foreground="{DynamicResource TextSecBrush}"
                                                           FontSize="11" VerticalAlignment="Center"
                                                           DockPanel.Dock="Left" Width="100"/>
                                                <Slider x:Name="HumanStrengthSlider" Style="{StaticResource NxSlider}"
                                                        Minimum="0" Maximum="100" Value="30"
                                                        SmallChange="1" LargeChange="10" TickFrequency="1"
                                                        IsSnapToTickEnabled="True"
                                                        VerticalAlignment="Center"
                                                        ToolTip="How much variation to add. Keep it low (20-40%)."
                                                        ValueChanged="HumanStrengthSlider_ValueChanged"/>
                                            </DockPanel>
                                            <TextBlock Text="Adds subtle random variation to make recoil look natural"
                                                       Foreground="#666666" FontSize="10" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </TabItem>

                        <!-- ─── TAB 2: Rapid Fire ──────────────────────── -->
                        <TabItem Header="Rapid Fire" Style="{StaticResource NxTabItem}">
                            <StackPanel Margin="0,10,0,10">
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="5" Padding="12,10">
                                    <StackPanel>

                                        <!-- Enable toggle -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Enable Rapid Fire"
                                                           Foreground="{DynamicResource TextPrimBrush}"
                                                           FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ToggleButton x:Name="RapidFireToggle" Grid.Column="1"
                                                          Style="{StaticResource NxToggle}"
                                                          ToolTip="Clicks mouse repeatedly while held. For semi-auto guns."
                                                          IsChecked="{Binding RapidFireEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          Click="RapidFireToggle_Click"/>
                                        </Grid>

                                        <!-- Fire rate slider -->
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock x:Name="FireRateLabel" Text="Fire Rate: 60ms"
                                                       Foreground="{DynamicResource TextSecBrush}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       DockPanel.Dock="Left" Width="105"/>
                                            <Slider x:Name="FireRateSlider" Style="{StaticResource NxSlider}"
                                                    Minimum="10" Maximum="150" Value="60"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Time between clicks in ms. Lower = faster."
                                                    ValueChanged="FireRateSlider_ValueChanged"/>
                                        </DockPanel>

                                        <!-- Aim key required checkbox -->
                                        <CheckBox x:Name="RapidFireAimKeyChk"
                                                  Style="{StaticResource NxCheckBox}"
                                                  Content="Aim Key Required"
                                                  ToolTip="Only rapid fires when your aim key is also held."
                                                  Margin="0,0,0,14"
                                                  Click="RapidFireAimKeyChk_Click"/>

                                        <!-- Info label -->
                                        <TextBlock Text="Rapid fire simulates repeated clicks while Mouse Button 1 is held."
                                                   Foreground="#666666"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Burst Mode -->
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="5" Padding="12,10" Margin="0,8,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Burst Mode"
                                                       Foreground="{DynamicResource TextPrimBrush}"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="BurstModeToggle" Grid.Column="1"
                                                          Style="{StaticResource NxToggle}"
                                                          ToolTip="Stops recoil after X shots. Good for DMRs and tap firing."
                                                          Click="BurstModeToggle_Click"/>
                                        </Grid>
                                        <StackPanel x:Name="BurstModePanel" Visibility="Collapsed"
                                                    Margin="0,10,0,0">
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock x:Name="BurstShotsLabel" Text="Shots: 5"
                                                           Foreground="{DynamicResource TextSecBrush}"
                                                           FontSize="11" VerticalAlignment="Center"
                                                           DockPanel.Dock="Left" Width="60"/>
                                                <Button x:Name="BurstResetBtn" Content="Reset"
                                                        Style="{StaticResource NxButton}"
                                                        DockPanel.Dock="Right"
                                                        Height="22" Padding="8,0" Margin="6,0,0,0"
                                                        ToolTip="Manually reset the shot counter to zero."
                                                        Click="BurstResetBtn_Click"/>
                                                <Slider x:Name="BurstShotsSlider" Style="{StaticResource NxSlider}"
                                                        Minimum="1" Maximum="15" Value="5"
                                                        SmallChange="1" LargeChange="5" TickFrequency="1"
                                                        IsSnapToTickEnabled="True"
                                                        VerticalAlignment="Center"
                                                        ToolTip="How many shots before recoil compensation stops."
                                                        ValueChanged="BurstShotsSlider_ValueChanged"/>
                                            </DockPanel>
                                            <CheckBox x:Name="BurstAutoResetChk"
                                                      Style="{StaticResource NxCheckBox}"
                                                      Content="Auto Reset" IsChecked="True"
                                                      ToolTip="Resets shot count when you release the aim key."
                                                      Margin="0,0,0,8"
                                                      Click="BurstAutoResetChk_Click"/>
                                            <TextBlock Text="Limits recoil compensation to the first X shots per spray. Useful for DMRs and burst fire weapons."
                                                       Foreground="#666666" FontSize="10" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- ─── TAB 3: Settings ────────────────────────── -->
                        <TabItem Header="Settings" Style="{StaticResource NxTabItem}">
                            <StackPanel Margin="0,10,0,10">
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="5" Padding="10,8" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Use Vdevice driver" Foreground="{DynamicResource TextPrimBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="DriverToggle" Grid.Column="1"
                                                          Style="{StaticResource NxToggle}"
                                                          ToolTip="On: Vdevice driver. Off: original Windows input. Switching leaves the engine inactive."
                                                          Click="DriverToggle_Click"/>
                                        </Grid>
                                        <TextBlock Text="On: Vdevice · Off: original input" Margin="0,6,0,0"
                                                   FontSize="10" Foreground="{DynamicResource TextSecBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Aim key + delay -->
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="SETTINGS"
                                               Foreground="{DynamicResource TextSecBrush}"
                                               FontSize="10" FontWeight="SemiBold"
                                               DockPanel.Dock="Left" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Separator Background="{DynamicResource SepBrush}"
                                               Height="1" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="5" Padding="10,8" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Aim Key"
                                                       Foreground="{DynamicResource TextSecBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="AimKeyCombo" Grid.Column="1"
                                                      Style="{StaticResource NxComboBox}"
                                                      ToolTip="The button you hold to aim. Must match your in-game ADS key."
                                                      SelectionChanged="AimKeyCombo_SelectionChanged">
                                                <ComboBoxItem>Right Mouse Button</ComboBoxItem>
                                                <ComboBoxItem>Left Mouse Button</ComboBoxItem>
                                                <ComboBoxItem>Middle Mouse Button</ComboBoxItem>
                                                <ComboBoxItem>Side Button 1</ComboBoxItem>
                                                <ComboBoxItem>Side Button 2</ComboBoxItem>
                                            </ComboBox>
                                        </Grid>
                                        <DockPanel>
                                            <TextBlock x:Name="DelayLabel" Text="Delay: 0ms"
                                                       Foreground="{DynamicResource TextSecBrush}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       DockPanel.Dock="Left" Width="80"/>
                                            <Slider x:Name="DelaySlider" Style="{StaticResource NxSlider}"
                                                    Minimum="0" Maximum="100" Value="0"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Wait time between each recoil movement in ms."
                                                    ValueChanged="DelaySlider_ValueChanged"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,10,0,0">
                                            <TextBlock x:Name="SensLabel" Text="Sensitivity: 1.00x"
                                                       Foreground="{DynamicResource TextSecBrush}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       DockPanel.Dock="Left" Width="120"/>
                                            <TextBox x:Name="SensBox" Text="1.00"
                                                     Style="{StaticResource NxTextBox}"
                                                     DockPanel.Dock="Right"
                                                     GotFocus="RecoilBox_GotFocus"
                                                     LostFocus="SensBox_LostFocus"/>
                                            <Slider x:Name="SensSlider" Style="{StaticResource NxSlider}"
                                                    Minimum="0.0" Maximum="2.0"
                                                    TickFrequency="0.05" SmallChange="0.05" LargeChange="0.25"
                                                    Value="1.0" VerticalAlignment="Center"
                                                    ToolTip="Scales all recoil values globally. 1.0 = normal. 0.0 = no movement. 2.0 = double strength. Match this to your in-game sensitivity."
                                                    ValueChanged="SensSlider_ValueChanged"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Hotkeys -->
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="HOTKEYS"
                                               Foreground="{DynamicResource TextSecBrush}"
                                               FontSize="10" FontWeight="SemiBold"
                                               DockPanel.Dock="Left" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Separator Background="{DynamicResource SepBrush}"
                                               Height="1" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="5" Padding="10,8">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Toggle UI"
                                                       Foreground="{DynamicResource TextSecBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                            <Button x:Name="ToggleKeyBtn" Grid.Column="1"
                                                    Style="{StaticResource HotkeyPill}"
                                                    ToolTip="Press this to show or hide the overlay."
                                                    Content="Insert" Click="ToggleKeyBtn_Click"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Enable Recoil"
                                                       Foreground="{DynamicResource TextSecBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                            <Button x:Name="EnableKeyBtn" Grid.Column="1"
                                                    Style="{StaticResource HotkeyPill}"
                                                    ToolTip="Press this to turn recoil compensation on."
                                                    Content="F1" Click="EnableKeyBtn_Click"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Disable Recoil"
                                                       Foreground="{DynamicResource TextSecBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                            <Button x:Name="DisableKeyBtn" Grid.Column="1"
                                                    Style="{StaticResource HotkeyPill}"
                                                    ToolTip="Press this to turn recoil compensation off."
                                                    Content="F2" Click="DisableKeyBtn_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ── Quick-Swap ──────────────────────────── -->
                                <DockPanel Margin="0,14,0,8">
                                    <TextBlock Text="QUICK-SWAP"
                                               Foreground="{DynamicResource TextSecBrush}"
                                               FontSize="10" FontWeight="SemiBold"
                                               DockPanel.Dock="Left" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Separator Background="{DynamicResource SepBrush}"
                                               Height="1" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="5" Padding="10,8" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Quick-Swap Hotkeys"
                                                       Foreground="{DynamicResource TextPrimBrush}"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="QuickSwapToggle" Grid.Column="1"
                                                          Style="{StaticResource NxToggle}"
                                                          ToolTip="Enable hotkeys to cycle through presets without opening the UI."
                                                          Click="QuickSwapToggle_Click"/>
                                        </Grid>
                                        <StackPanel x:Name="QuickSwapPillsPanel"
                                                    Visibility="Collapsed" Margin="0,10,0,0">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Next Preset"
                                                           Foreground="{DynamicResource TextSecBrush}"
                                                           FontSize="11" VerticalAlignment="Center"/>
                                                <Button x:Name="NextPresetKeyBtn" Grid.Column="1"
                                                        Style="{StaticResource HotkeyPill}"
                                                        ToolTip="Press this to switch to the next weapon preset."
                                                        Content="PgDn"
                                                        Click="NextPresetKeyBtn_Click"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Previous Preset"
                                                           Foreground="{DynamicResource TextSecBrush}"
                                                           FontSize="11" VerticalAlignment="Center"/>
                                                <Button x:Name="PrevPresetKeyBtn" Grid.Column="1"
                                                        Style="{StaticResource HotkeyPill}"
                                                        ToolTip="Press this to go back to the previous preset."
                                                        Content="PgUp"
                                                        Click="PrevPresetKeyBtn_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ── Stream Proof ─────────────────────────── -->
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="STREAM PROOF"
                                               Foreground="{DynamicResource TextSecBrush}"
                                               FontSize="10" FontWeight="SemiBold"
                                               DockPanel.Dock="Left" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Separator Background="{DynamicResource SepBrush}"
                                               Height="1" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="5" Padding="10,8" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Stream Proof"
                                                       Foreground="{DynamicResource TextPrimBrush}"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="StreamProofToggle" Grid.Column="1"
                                                          Style="{StaticResource NxToggle}"
                                                          ToolTip="Hides the app from OBS, Discord, and all screen capture."
                                                          Click="StreamProofToggle_Click"/>
                                        </Grid>
                                        <TextBlock Text="Hides the overlay from OBS, Discord, and all capture software. Windows 10 2004+ only."
                                                   Foreground="#666666" FontSize="10"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- ── Recoil Curve ──────────────────────────── -->
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="RECOIL CURVE"
                                               Foreground="{DynamicResource TextSecBrush}"
                                               FontSize="10" FontWeight="SemiBold"
                                               DockPanel.Dock="Left" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Separator Background="{DynamicResource SepBrush}"
                                               Height="1" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="5" Padding="10,8" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Recoil Curve"
                                                       Foreground="{DynamicResource TextPrimBrush}"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="CurveToggle" Grid.Column="1"
                                                          Style="{StaticResource NxToggle}"
                                                          ToolTip="Starts recoil weak and ramps up. More natural spray."
                                                          Click="CurveToggle_Click"/>
                                        </Grid>
                                        <StackPanel x:Name="CurveSectionPanel"
                                                    Visibility="Collapsed" Margin="0,10,0,0">
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock x:Name="RampLabel"
                                                           Text="Ramp Shots: 10"
                                                           Foreground="{DynamicResource TextSecBrush}"
                                                           FontSize="11" VerticalAlignment="Center"
                                                           DockPanel.Dock="Left" Width="115"/>
                                                <Slider x:Name="RampSlider"
                                                        Style="{StaticResource NxSlider}"
                                                        Minimum="1" Maximum="30" Value="10"
                                                        VerticalAlignment="Center"
                                                        ToolTip="How many shots until recoil reaches full strength."
                                                        ValueChanged="RampSlider_ValueChanged"/>
                                            </DockPanel>
                                            <TextBlock Text="Compensation reaches full strength after ~N shots."
                                                       Foreground="#666666" FontSize="10"
                                                       Margin="0,0,0,8"/>
                                            <Canvas x:Name="CurveCanvas" Width="200" Height="60"
                                                    Background="{DynamicResource ElevatedBrush}"
                                                    HorizontalAlignment="Left">
                                                <Polyline x:Name="CurvePolyline"
                                                          Stroke="{DynamicResource AccentBrush}"
                                                          StrokeThickness="1.5"
                                                          StrokeLineJoin="Round"/>
                                            </Canvas>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ── Watermark ─────────────────────────────── -->
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="OVERLAY"
                                               Foreground="{DynamicResource TextSecBrush}"
                                               FontSize="10" FontWeight="SemiBold"
                                               DockPanel.Dock="Left" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Separator Background="{DynamicResource SepBrush}"
                                               Height="1" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="5" Padding="10,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Overlay Watermark"
                                                       Foreground="{DynamicResource TextPrimBrush}"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="WatermarkToggle" Grid.Column="1"
                                                          Style="{StaticResource NxToggle}"
                                                          ToolTip="Shows a small overlay with the tool name and active status."
                                                          Click="WatermarkToggle_Click"/>
                                        </Grid>
                                        <TextBlock Text="⚠ Game must be in Borderless Windowed mode for watermark to appear on top."
                                                   Foreground="#f59e0b"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"
                                                   Visibility="{Binding IsChecked, ElementName=WatermarkToggle, Converter={StaticResource BoolToVisConverter}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- ── Sound Effects ───────────────────────── -->
                                <DockPanel Margin="0,14,0,8">
                                    <TextBlock Text="SOUND EFFECTS"
                                               Foreground="{DynamicResource TextSecBrush}"
                                               FontSize="10" FontWeight="SemiBold"
                                               DockPanel.Dock="Left" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Separator Background="{DynamicResource SepBrush}"
                                               Height="1" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="5" Padding="10,8">
                                    <StackPanel>
                                        <!-- Toggle row -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Sound Effects"
                                                       Foreground="{DynamicResource TextPrimBrush}"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="SoundToggle" Grid.Column="1"
                                                          Style="{StaticResource NxToggle}"
                                                          ToolTip="Plays a click when recoil turns on or off."
                                                          Click="SoundToggle_Click"/>
                                        </Grid>
                                        <!-- No-device warning (outside sub-panel so visible when toggle off) -->
                                        <TextBlock x:Name="NoAudioDeviceLabel"
                                                   Text="No audio device found"
                                                   Foreground="#ef4444"
                                                   FontSize="10" Margin="0,4,0,0"
                                                   Visibility="Collapsed"/>
                                        <!-- Sub-panel: shown only when sound is enabled -->
                                        <StackPanel x:Name="SoundSubPanel"
                                                    Visibility="Collapsed" Margin="0,10,0,0">
                                            <!-- Volume slider -->
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock x:Name="SoundVolumeLabel"
                                                           Text="Volume: 70%"
                                                           Foreground="{DynamicResource TextSecBrush}"
                                                           FontSize="11" VerticalAlignment="Center"
                                                           DockPanel.Dock="Left" Width="90"/>
                                                <Slider x:Name="SoundVolumeSlider"
                                                        Style="{StaticResource NxSlider}"
                                                        Minimum="0" Maximum="100" Value="70"
                                                        VerticalAlignment="Center"
                                                        ToolTip="How loud the click sound is."
                                                        ValueChanged="SoundVolumeSlider_ValueChanged"/>
                                            </DockPanel>
                                            <!-- Custom sound picker -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Button x:Name="CustomSoundBtn"
                                                        Style="{StaticResource NxButton}"
                                                        Content="Use Custom Sound"
                                                        ToolTip="Use your own .wav or .mp3 instead of the default."
                                                        Padding="8,4" FontSize="11"
                                                        Click="CustomSoundBtn_Click"/>
                                                <TextBlock x:Name="CustomSoundNameLabel"
                                                           Foreground="{DynamicResource TextSecBrush}"
                                                           FontSize="11" VerticalAlignment="Center"
                                                           Margin="8,0,4,0"
                                                           Visibility="Collapsed"
                                                           ToolTip="Currently using this custom sound. Click ✕ to go back to default."/>
                                                <Button x:Name="RemoveCustomSoundBtn"
                                                        Style="{StaticResource NxButton}"
                                                        Content="✕ Remove"
                                                        ToolTip="Go back to the default mechanical click sound."
                                                        Padding="6,4" FontSize="11"
                                                        Visibility="Collapsed"
                                                        Click="RemoveCustomSoundBtn_Click"/>
                                            </StackPanel>
                                            <!-- Test button -->
                                            <Button x:Name="SoundTestBtn"
                                                    Style="{StaticResource NxButton}"
                                                    Content="▶ Test"
                                                    ToolTip="Preview the current sound at the current volume."
                                                    HorizontalAlignment="Left"
                                                    Padding="8,4" FontSize="11"
                                                    Margin="0,0,0,8"
                                                    Click="SoundTestBtn_Click"/>
                                            <!-- Info label -->
                                            <TextBlock Foreground="#666666" FontSize="10"
                                                       TextWrapping="Wrap">
                                                <Run Text="Supported formats: .wav  .mp3"/>
                                                <LineBreak/>
                                                <Run Text="Sound plays when you press F1 (on) or F2 (off)."/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </TabItem>

                        <!-- ─── TAB 4: UI Settings ─────────────────────── -->
                        <TabItem Header="UI" Style="{StaticResource NxTabItem}">
                            <StackPanel Margin="0,10,0,10">

                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="THEME COLORS"
                                               Foreground="{DynamicResource TextSecBrush}"
                                               FontSize="10" FontWeight="SemiBold"
                                               DockPanel.Dock="Left" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Separator Background="{DynamicResource SepBrush}"
                                               Height="1" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="5" Padding="10,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <!-- Accent Color -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Accent Color"
                                                       Foreground="{DynamicResource TextSecBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                            <xctk:ColorPicker x:Name="AccentPicker" Grid.Column="1"
                                                              Height="26"
                                                              ToolTip="Main highlight color used across the app."
                                                              SelectedColorChanged="AccentPicker_SelectedColorChanged"/>
                                            <Button Grid.Column="3" Content="Reset"
                                                    Style="{StaticResource NxButton}"
                                                    FontSize="10" Padding="4,3"
                                                    Tag="Accent"
                                                    Click="ThemeResetOne_Click"/>
                                        </Grid>
                                        <!-- Background -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Background"
                                                       Foreground="{DynamicResource TextSecBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                            <xctk:ColorPicker x:Name="BgPicker" Grid.Column="1"
                                                              Height="26"
                                                              ToolTip="Main window background color."
                                                              SelectedColorChanged="BgPicker_SelectedColorChanged"/>
                                            <Button Grid.Column="3" Content="Reset"
                                                    Style="{StaticResource NxButton}"
                                                    FontSize="10" Padding="4,3"
                                                    Tag="Bg"
                                                    Click="ThemeResetOne_Click"/>
                                        </Grid>
                                        <!-- Surface -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Surface"
                                                       Foreground="{DynamicResource TextSecBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                            <xctk:ColorPicker x:Name="SurfacePicker" Grid.Column="1"
                                                              Height="26"
                                                              ToolTip="Panel and card background color."
                                                              SelectedColorChanged="SurfacePicker_SelectedColorChanged"/>
                                            <Button Grid.Column="3" Content="Reset"
                                                    Style="{StaticResource NxButton}"
                                                    FontSize="10" Padding="4,3"
                                                    Tag="Surface"
                                                    Click="ThemeResetOne_Click"/>
                                        </Grid>
                                        <!-- Text Color -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Text Color"
                                                       Foreground="{DynamicResource TextSecBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                            <xctk:ColorPicker x:Name="TextPrimPicker" Grid.Column="1"
                                                              Height="26"
                                                              ToolTip="Main text color."
                                                              SelectedColorChanged="TextPrimPicker_SelectedColorChanged"/>
                                            <Button Grid.Column="3" Content="Reset"
                                                    Style="{StaticResource NxButton}"
                                                    FontSize="10" Padding="4,3"
                                                    Tag="TextPrim"
                                                    Click="ThemeResetOne_Click"/>
                                        </Grid>
                                        <!-- Secondary Text -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Secondary Text"
                                                       Foreground="{DynamicResource TextSecBrush}"
                                                       FontSize="11" VerticalAlignment="Center"/>
                                            <xctk:ColorPicker x:Name="TextSecPicker" Grid.Column="1"
                                                              Height="26"
                                                              ToolTip="Dimmed text and label color."
                                                              SelectedColorChanged="TextSecPicker_SelectedColorChanged"/>
                                            <Button Grid.Column="3" Content="Reset"
                                                    Style="{StaticResource NxButton}"
                                                    FontSize="10" Padding="4,3"
                                                    Tag="TextSec"
                                                    Click="ThemeResetOne_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Reset all -->
                                <Button Content="Reset All to Defaults"
                                        Style="{StaticResource NxButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,10"
                                        ToolTip="Restore all colors back to the original red theme."
                                        Click="ThemeResetAll_Click"/>

                                <!-- Tooltips -->
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="TOOLTIPS"
                                               Foreground="{DynamicResource TextSecBrush}"
                                               FontSize="10" FontWeight="SemiBold"
                                               DockPanel.Dock="Left" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Separator Background="{DynamicResource SepBrush}"
                                               Height="1" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="5" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Tooltips"
                                                       Foreground="{DynamicResource TextPrimBrush}"
                                                       FontSize="12" VerticalAlignment="Center"/>
                                            <ToggleButton x:Name="TooltipsToggle" Grid.Column="1"
                                                          Style="{StaticResource NxToggle}"
                                                          IsChecked="True"
                                                          ToolTip="Show or hide these helpful hints when hovering controls."
                                                          Click="TooltipsToggle_Click"/>
                                        </Grid>
                                        <TextBlock Text="Hover over any control for 1 second to see what it does"
                                                   Foreground="#666666" FontSize="10" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Preview panel -->
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="PREVIEW"
                                               Foreground="{DynamicResource TextSecBrush}"
                                               FontSize="10" FontWeight="SemiBold"
                                               DockPanel.Dock="Left" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <Separator Background="{DynamicResource SepBrush}"
                                               Height="1" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Border Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="5" Padding="12,10">
                                    <StackPanel>
                                        <Slider Style="{StaticResource NxSlider}"
                                                Value="30" Minimum="0" Maximum="50"
                                                IsEnabled="True" Margin="0,0,0,8"/>
                                        <Button Content="Sample Button"
                                                Style="{StaticResource NxButton}"
                                                HorizontalAlignment="Left"
                                                Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8"
                                                     Fill="{DynamicResource AccentBrush}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="  ACTIVE"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </TabItem>

                    </TabControl>
                    <!-- ══ end MainTabs ═════════════════════════════════ -->

                    <!-- ══ WEAPON PRESETS (always visible) ══════════════ -->
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="WEAPON PRESETS"
                                   Foreground="{DynamicResource TextSecBrush}"
                                   FontSize="10" FontWeight="SemiBold"
                                   DockPanel.Dock="Left" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Separator Background="{DynamicResource SepBrush}"
                                   Height="1" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Border Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="5" Padding="10,10" Margin="0,0,0,14">
                        <StackPanel>
                            <TabControl x:Name="PresetTabs" Style="{StaticResource NxTabControl}"
                                        SelectionChanged="PresetTabs_SelectionChanged">

                                <TabItem Header="Attackers" Style="{StaticResource NxTabItem}"
                                         ToolTip="Weapons used by attacking operators.">
                                    <ComboBox x:Name="AttackerCombo"
                                              Style="{StaticResource NxComboBox}"
                                              ToolTip="Select a weapon to load its recoil settings."
                                              Margin="0,8,0,0"
                                              SelectionChanged="PresetCombo_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Foreground="{DynamicResource TextPrimBrush}"
                                                           FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                                    <Setter Property="Foreground" Value="#888888"/>
                                                                    <Setter Property="FontSize"   Value="10"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="Margin"     Value="0,2,0,0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem"
                                                   BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Focusable" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                </TabItem>

                                <TabItem Header="Defenders" Style="{StaticResource NxTabItem}"
                                         ToolTip="Weapons used by defending operators.">
                                    <ComboBox x:Name="DefenderCombo"
                                              Style="{StaticResource NxComboBox}"
                                              ToolTip="Select a weapon to load its recoil settings."
                                              Margin="0,8,0,0"
                                              SelectionChanged="PresetCombo_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Foreground="{DynamicResource TextPrimBrush}"
                                                           FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                                    <Setter Property="Foreground" Value="#888888"/>
                                                                    <Setter Property="FontSize"   Value="10"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Setter Property="Margin"     Value="0,2,0,0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem"
                                                   BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Focusable" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                </TabItem>

                                <TabItem Header="Custom" Style="{StaticResource NxTabItem}"
                                         ToolTip="Your saved personal presets.">
                                    <ComboBox x:Name="CustomCombo"
                                              Style="{StaticResource NxComboBox}"
                                              ToolTip="Select a weapon to load its recoil settings."
                                              Margin="0,8,0,0"
                                              SelectionChanged="PresetCombo_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource TextPrimBrush}"
                                                           FontSize="12"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </TabItem>

                            </TabControl>

                            <!-- Preset action buttons -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Button x:Name="LoadBtn"   Grid.Column="0" Grid.Row="0" Content="Load"
                                        Style="{StaticResource NxButton}" Click="LoadBtn_Click"
                                        ToolTip="Apply the selected preset to the sliders."/>
                                <Button x:Name="SaveBtn"   Grid.Column="2" Grid.Row="0" Content="Save"
                                        Style="{StaticResource NxButton}" Click="SaveBtn_Click"
                                        IsEnabled="False"
                                        ToolTip="Save current slider values to the selected preset."/>
                                <Button x:Name="NewBtn"    Grid.Column="4" Grid.Row="0" Content="New"
                                        Style="{StaticResource NxButton}" Click="NewBtn_Click"
                                        ToolTip="Create a new preset from current slider values."/>
                                <Button x:Name="DeleteBtn" Grid.Column="0" Grid.Row="2" Content="Delete"
                                        Style="{StaticResource NxButton}" Click="DeleteBtn_Click"
                                        IsEnabled="False"
                                        ToolTip="Remove the selected custom preset."/>
                                <Button x:Name="ExportBtn" Grid.Column="2" Grid.Row="2" Content="Export"
                                        Style="{StaticResource NxButton}" Click="ExportBtn_Click"
                                        IsEnabled="False"
                                        ToolTip="Save the selected preset as a file to share."/>
                                <Button x:Name="ImportBtn" Grid.Column="4" Grid.Row="2" Content="Import"
                                        Style="{StaticResource NxButton}" Click="ImportBtn_Click"
                                        ToolTip="Load a preset from a file."/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ── Update banner (hidden until update detected) ──────── -->
            <Border x:Name="UpdateBanner" Grid.Row="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="UpdateText"
                               Foreground="{DynamicResource TextPrimBrush}"
                               FontSize="11" VerticalAlignment="Center"
                               TextDecorations="Underline" Cursor="Hand"
                               MouseLeftButtonDown="UpdateBanner_Click"/>
                    <Button Grid.Column="1" Content="✕"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="UpdateBannerDismiss_Click"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
