<Window x:Class="Nexus_Recoil.WatermarkOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="False"
        ShowActivated="False"
        Width="180"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        Title="Nexus Recoil Watermark">

    <Border Background="#D2141414"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1" CornerRadius="8"
            Padding="10,8">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Nexus Recoil"
                           Foreground="White"
                           FontFamily="Rajdhani, Segoe UI"
                           FontSize="13" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Ellipse Grid.Column="1" Width="6" Height="6"
                         Fill="{DynamicResource AccentBrush}"
                         VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="WmStatusText"
                       Text="Status: INACTIVE"
                       Foreground="#888888"
                       FontFamily="DM Sans, Segoe UI"
                       FontSize="11"
                       Margin="0,3,0,0"/>
        </StackPanel>
    </Border>
</Window>
