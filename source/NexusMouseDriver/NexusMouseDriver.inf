[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745A17A0-74D3-11D0-B6FE-00A0C90F57DA}
Provider=%Provider%
CatalogFile=NexusMouseDriver.cat
DriverVer=10/25/2026,1.0.0.0
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0

[Models.NTamd64.10.0]
%DeviceDescription%=Install,Root\NexusVirtualMouse

[DestinationDirs]
DriverCopy=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
NexusMouseDriver.sys=1

[Install.NT]
CopyFiles=DriverCopy

[DriverCopy]
NexusMouseDriver.sys

[Install.NT.HW]
AddReg=VhfFilter

[VhfFilter]
HKR,,LowerFilters,0x00010000,"vhf"

[Install.NT.Services]
AddService=NexusMouseDriver,0x00000002,Service

[Service]
DisplayName=%DeviceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\NexusMouseDriver.sys

[Install.NT.Wdf]
KmdfService=NexusMouseDriver,Kmdf

[Kmdf]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
Provider="Nexus Recoil"
DeviceDescription="Nexus Virtual Mouse"
DiskName="Nexus Virtual Mouse installation media"
